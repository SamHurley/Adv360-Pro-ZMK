#include <behaviors.dtsi>
#include "includes/custom_behaviors.dtsi"
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define NUM   1
#define FUNC  2
#define MOUSE 3
#define MOD   4

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"
    };

  combos {
      compatible = "zmk,combos";

      combo_home {
          timeout-ms = <50>;
          key-positions = <40 41>;
          bindings = <&kp HOME>;
      };

      combo_end {
          timeout-ms = <50>;
          key-positions = <41 42>;
          bindings = <&kp END>;
      };

      combo_pg_up {
          timeout-ms = <50>;
          key-positions = <23 24>;
          bindings = <&kp PG_UP>;
      };

      combo_pg_dn {
          timeout-ms = <50>;
          key-positions = <55 56>;
          bindings = <&kp PG_DN>;
      };

  };

  keymap {
    compatible = "zmk,keymap";

    base_layer {
      display-name = "Base";
      bindings = <
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|                                                                                                                      |------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &bootloader        &none              &kp UNDER          &kp F3             &none              &none              &to MOUSE                                                                                                                                 &mo MOD            &none              &none              &kp F8             &kp MINUS          &none              &bootloader
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|                                                                                                                      |------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &none              &kp Q              &kp W              &kp E              &kp R              &kp T              &none                                                                                                                                     &none              &kp Y              &kp U              &kp I              &kp O              &kp P              &none
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|    |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &skq LSHFT         &kp A              &kp S              &hm_l LCTRL D      &hm_l LALT F       &kp G              &none                                 &kp LCTRL          &kp LALT                &kp LGUI           &kp RCTRL                             &none              &kp H              &hm_r RALT J       &hm_r RCTRL K      &kp L              &kp SEMI           &td_shift
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|    |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &kp EQUAL          &kp Z              &kp X              &kp C              &kp V              &kp B                                                                       &kp HOME                &kp PG_UP                                                                   &kp N              &kp M              &kp COMMA          &kp DOT            &kp FSLH           &kp SQT
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|    |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &hm_l LWIN GRAVE   &none              &none              &kp ESC            &kp TAB                                                  &lt NUM BSPC       &kp DEL            &kp END                 &kp PG_DN          &kp ENTER          &kp SPACE                                                &kp LEFT           &kp DOWN           &kp UP             &kp RIGHT          &hm_r RWIN BSLH
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|    |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
      >;
    };
    num {
      display-name = "Num";
      bindings = <
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|                                                                                                                      |------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &trans             &trans             &trans             &trans             &trans             &trans                                                                                                                                    &trans             &trans             &trans             &trans             &trans             &trans             &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|                                                                                                                      |------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &kp LBKT           &kp AMPERSAND      &kp STAR           &none              &kp RBKT           &trans                                                                                                                                    &trans             &kp STAR           &kp N7             &kp N8             &kp N9             &none              &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|    |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &kp LPAR           &kp DOLLAR         &hm_l LCTRL PRCNT  &hm_l LALT CARET   &kp RPAR           &trans                                &trans             &trans                  &trans             &trans                                &trans             &kp PLUS           &hm_r RALT N4      &hm_r RCTRL N5     &kp N6             &trans             &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|    |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &kp LBRC           &kp EXCL           &kp AT             &kp HASH           &kp RBRC                                                                    &trans                  &trans                                                                      &none              &kp N1             &kp N2             &kp N3             &trans             &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|    |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &trans             &trans             &trans             &trans                                                   &trans             &trans             &trans                  &trans             &trans             &lt FUNC SPACE                                           &kp N0             &none              &kp DOT            &none              &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|    |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
      >;
    };

    func {
      display-name = "Func";
      bindings = <
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|                                                                                                                      |------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &trans             &trans             &trans             &trans             &trans             &trans                                                                                                                                    &trans             &trans             &trans             &trans             &trans             &trans             &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|                                                                                                                      |------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &none              &none              &none              &none              &none              &trans                                                                                                                                    &trans             &kp F12            &kp F7             &kp F8             &kp F9             &none              &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|    |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &none              &none              &kp LCTRL          &kp LALT           &none              &trans                                &trans             &trans                  &trans             &trans                                &trans             &kp F11            &kp F4             &kp F5             &kp F6             &none              &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|    |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &none              &none              &none              &none              &none                                                                       &trans                  &trans                                                                      &kp F10            &kp F1             &kp F2             &kp F3             &none              &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|    |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &trans             &trans             &trans             &trans                                                   &trans             &trans             &trans                  &trans             &trans             &trans                                                   &trans             &trans             &trans             &trans             &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|    |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
      >;
    };

    mouse {
      display-name = "Mouse";
      bindings = <
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|                                                                                                                      |------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &trans             &trans             &trans             &trans             &trans             &to BASE                                                                                                                                  &trans             &trans             &trans             &trans             &trans             &trans             &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|                                                                                                                      |------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &none              &none              &none              &none              &none              &trans                                                                                                                                    &trans             &none              &none              &none              &none              &none              &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|    |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &kp LC(A)          &kp LC(S)          &none              &none              &none              &trans                                &trans             &trans                  &trans             &trans                                &trans             &none              &none              &none              &none              &none              &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|    |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &kp LC(Z)          &kp LC(X)          &kp LC(C)          &kp LC(V)          &none                                                                       &trans                  &trans                                                                      &none              &none              &none              &none              &none              &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|    |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
    &trans             &trans             &trans             &trans             &trans                                                   &trans             &trans             &trans                  &trans             &trans             &trans                                                   &trans             &trans             &trans             &trans             &trans
// |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|    |------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|------------------|
      >;
    };

    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };

  };
};
